pragma language_version >= 0.16;

import CompactStandardLibrary;

struct CreditProfile {
  score: Uint<16>;
  liquidationCount: Uint<16>;
  accountAgeMonths: Uint<16>;
}

witness localSecretKey(): Bytes<32>;
witness creditData(): CreditProfile;

export ledger loans: Map<Bytes<32>, Uint<64>>;
export ledger totalLoansIssued: Counter;

export circuit requestLoan(loanAmount: Uint<64>, minScore: Uint<16>): [] {
  const profile = creditData();

  assert(profile.score >= minScore, "Score below required threshold");
  assert(profile.liquidationCount == 0, "Borrower has an outstanding liquidation");
  assert(profile.accountAgeMonths >= 6, "Wallet history too short");

  const borrower = disclose(borrowerPublicKey());
  assert(!loans.member(borrower), "Borrower already has an active loan");

  loans.insert(borrower, disclose(loanAmount));
  totalLoansIssued.increment(1);
}

export circuit repayLoan(): [] {
  const borrower = disclose(borrowerPublicKey());
  assert(loans.member(borrower), "No active loan to repay");
  loans.remove(borrower);
}

// Not ownPublicKey(): that value is prover-claimed and never checked
// against the transaction signer, so it can't be trusted for identity.
circuit borrowerPublicKey(): Bytes<32> {
  return persistentHash<[Bytes<23>, Bytes<32>]>(["ghost-credit:user:pk:v1", localSecretKey()]);
}

export circuit getLoanStatus(borrower: Bytes<32>): Uint<64> {
  const target = disclose(borrower);
  if (loans.member(target)) {
    return loans.lookup(target);
  }
  return 0;
}
