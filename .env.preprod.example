# Copy this to .env.preprod and fill in ONLY ONE of the following for a wallet
# you will fund via the Preprod faucet (https://midnight-tmnight-preprod.nethermind.dev/).
# This wallet must also hold DUST (delegate via Lace or 1AM).

# Set only one, delete the other
MIDNIGHT_PREPROD_MNEMONIC=replace-with-24-word-mnemonic
MIDNIGHT_PREPROD_SEED=replace-with-a-64-char-hex-seed
